<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The main chat window. The AnchorPane pins the scrolling message area to the
  top and the input row (text field + Send button) to the bottom.
  fx:controller ties every fx:id and onAction below to pan.MainWindow.
-->
<AnchorPane fx:id="mainLayout" prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pan.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    AnchorPane.topAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0"
                    AnchorPane.bottomAnchor="40.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command and press Enter..."
                   AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="62.0" AnchorPane.bottomAnchor="1.0" />
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" prefWidth="60.0"
                AnchorPane.rightAnchor="1.0" AnchorPane.bottomAnchor="1.0" />
    </children>
</AnchorPane>